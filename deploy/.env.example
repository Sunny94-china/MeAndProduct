# 请使用仓库根目录 .env.example；完整运维说明见 docs/deploy.md。
# 本文件仅作同步占位。

TAG=latest
BACKEND_IMAGE=meandproduct-backend:latest
PUBLIC_IMAGE=meandproduct-public:latest
ADMIN_IMAGE=meandproduct-admin:latest

API_PORT=18080
PUBLIC_PORT=18081
ADMIN_PORT=18082

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=meandproduct
MYSQL_PASSWORD=change_me_app_pwd_456
MYSQL_DB=meandproduct

REDIS_ADDR=host.docker.internal:6379
REDIS_PASSWORD=
REDIS_DB=11

JWT_SECRET=please_change_me_to_a_long_random_string_at_least_32_chars
JWT_BLACKLIST_PREFIX=mp:jwt:blacklist:

CORS_ALLOW_ORIGINS=*

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=Admin@123
