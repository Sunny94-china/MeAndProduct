# =============================================================================
# 不提交：密钥、本机构建产物、依赖、镜像包、编辑器/系统垃圾
# 要提交：*.example、源码、Dockerfile、compose、migrations、lockfile
# =============================================================================

# ------------ 环境变量与密钥（示例文件要保留）------------
.env
.env.*
!.env.example
!**/.env.example
config.yaml
!config.yaml.example
!**/config.yaml.example
*.pem
*.key
*.crt
*.p12
credentials.json
secrets/

# ------------ Go ------------
vendor/
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
__debug_bin*
debug
go.work
go.work.sum

# ------------ Node / 前端构建 ------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------ 部署打包产物（make pack / docker save）------------
dist/images/
dist/pack/
dist/release/
*.tar
*.tar.gz
*-web.tar.gz
host-nginx.generated.conf
**/host-nginx.generated.conf
deploy/backup/*
!deploy/backup/.gitkeep

# ------------ 日志与临时文件 ------------
logs/
*.log
nohup.out
tmp/
.tmp/
*.tmp
*.sql.tmp
*.pid
*.swp
*.swo
*~

# ------------ 测试覆盖率 ------------
coverage/
coverage.out
.coverage/
*.coverprofile

# ------------ 编辑器 / OS ------------
.idea/
.vscode/
*.code-workspace
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

