server:
  host: 127.0.0.1
  port: 8080
  mode: dev
  read_timeout: 30s
  write_timeout: 30s

mysql:
  host: 127.0.0.1
  port: 3306
  user: meandproduct
  password: dev_pwd
  db: meandproduct
  max_idle_conns: 10
  max_open_conns: 50
  migrate_auto: true

redis:
  addr: 127.0.0.1:6379
  password: dev_redis_pwd
  db: 0
  pool_size: 20

jwt:
  secret: local-dev-jwt-secret-change-me-0000000000000000
  access_ttl: 2h
  refresh_ttl: 168h
  issuer: meandproduct.dev
  blacklist_prefix: mp:jwt:blacklist:

migration:
  path: file://migrations

cors:
  allow_origins: "http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175"
  allow_methods: "GET,POST,PUT,DELETE,OPTIONS,PATCH"
  allow_headers: "Origin,Content-Type,Accept,Authorization,X-Request-Id"
  allow_credentials: true
  max_age: 86400

ratelimit:
  login_limit: 60
  login_window: 5m
  report_limit: 5
  report_window: 1h
  general_limit: 300
  general_window: 1m

app_env: development

# 启动时写入数据库的固定管理员。改密码后重启后端会同步。
admin:
  username: admin
  email: admin@local
  password: Admin@123
