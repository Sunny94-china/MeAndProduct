# 服务器运行配置模板。复制为 .env 后修改。
# 部署步骤见 docs/deploy.md（发布包内为 deploy.md）。
#
# 服务器目录只需：
#   docker-compose.yml  .env  meandproduct-*-web.tar.gz  （+ deploy.md）
# 不要放 backend/ frontend/ 源码。

TAG=latest
BACKEND_IMAGE=meandproduct-backend:latest
PUBLIC_IMAGE=meandproduct-public:latest
ADMIN_IMAGE=meandproduct-admin:latest

# 只监听 127.0.0.1，给已有 Nginx 反代。不要改成 80/443。
API_PORT=18080
PUBLIC_PORT=18081
ADMIN_PORT=18082

# --- 服务器已有 MySQL（专用库/用户，避免冲突）---
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=meandproduct
MYSQL_PASSWORD=change_me_app_pwd_456
MYSQL_DB=meandproduct

# --- 服务器已有 Redis（建议独立 DB，勿占 0）---
REDIS_ADDR=host.docker.internal:6379
REDIS_PASSWORD=
REDIS_DB=11

# openssl rand -hex 32
JWT_SECRET=please_change_me_to_a_long_random_string_at_least_32_chars
JWT_BLACKLIST_PREFIX=mp:jwt:blacklist:

CORS_ALLOW_ORIGINS=*

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=Admin@123
